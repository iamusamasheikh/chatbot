# Server Configuration
PORT=3000
PUBLIC_URL=https://divafits.com

# OpenRouter Free LLM API Key (Get free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: LLM Model override (default: poolside/laguna-s-2.1:free or openrouter/free)
LLM_MODEL=poolside/laguna-s-2.1:free

# Security: Set to true in production to restrict widget usage only to your domain
STRICT_ORIGIN=true

# Optional: JWT Secret (auto-generated if omitted)
# JWT_SECRET=change-this-to-a-secure-random-string
